---
interface Props { name: 'notebook' | 'plane' | 'folder' | 'up-right' | 'down' | 'close' | 'menu' | 'terminal'; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'notebook' && <><path d="m5.5 3.7 13-.7q1.2 0 1.3 1.4l.5 15.7-14 1.1z" fill="var(--lime)" /><path d="m8.2 4 .6 16.3M3.6 7.3l3.7-.4m-3.5 5.2 3.7-.3m-3.6 5.3 3.9-.5m2.9-8.4 5.6-.3m-5.5 3.8 3.6-.2" /></>}
  {name === 'plane' && <><path d="m2.6 10.4 18-7-6.2 17-3.2-6.7-8.6-3.3Z"/><path d="m11.2 13.7 9.4-10.3"/></>}
  {name === 'folder' && <path d="M3 7.5V5.2c0-.7.5-1.2 1.2-1.2H9l2.2 2.5h8.6c.7 0 1.2.5 1.2 1.2v10.7c0 .7-.5 1.3-1.2 1.3H4.2c-.7 0-1.2-.5-1.2-1.2V7.5Zm.1 2.2h17.7"/>}
  {name === 'up-right' && <path d="m6.8 17.2 10.4-10.4M7 6.8h10.2v10.3"/>}
  {name === 'down' && <path d="M12.2 3.2c-.7 4.9-.6 10.5.1 16.5m-6.8-7.5 6.8 7.5 6-7.2"/>}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18"/>}
  {name === 'menu' && <path d="m3 6 18-.6M3 12l18 .4M3 18l18-.5"/>}
  {name === 'terminal' && <path d="m3.5 6 6 6-6 6m9-1h8"/>}
</svg>
