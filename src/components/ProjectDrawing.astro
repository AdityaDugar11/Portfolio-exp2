---
interface Props { drawing: string }
const { drawing } = Astro.props;
const hatch = 'url(#work-hatch-' + drawing + ')';
---
<svg class="work-drawing" viewBox="0 0 360 196" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
  <defs>
    <pattern id={'work-hatch-' + drawing} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
      <path d="M.5 -2 L.2 7" stroke-width=".85" opacity=".68" />
    </pattern>
  </defs>
  {drawing === 'schemes' && <>
    <g transform="rotate(-6 175 102)">
      <path d="m84 78 117-29 55 75-119 37z" class="drawing-page" data-ink="1" pathLength="1" />
      <path d="m86 81 50 85 123-38-4-4-118 36z" fill={hatch} />
      <path d="m77 72 116-30 59 75-118 36z" class="drawing-page" data-ink="1" pathLength="1" />
      <path d="m77 72 57 81 5 3 115-36-2-3-118 35z" fill={hatch} />
      <path d="m75 64 117-32 57 77-119 37z" class="drawing-page" data-ink="1" pathLength="1" />
      <path d="m77 66 52 78m-48-79 110-30 53 72" opacity=".45" stroke-width=".8" data-ink="2" pathLength="1"/>
      <path d="m95 67 63-17 3 4-63 18z" fill="currentColor" stroke="none"/>
      <path d="m101 77 38-10m-35 16 74-21m-71 26 55-14" opacity=".85" data-ink="2" pathLength="1"/>
      <path d="m118 101 7-2 4 5-7 3zm6 10 7-2 4 5-7 2zm7 10 7-2 4 5-7 2z" data-ink="2" pathLength="1"/>
      <path d="m118 100 5 2 5-11m-3 19 6 3 5-11m0 18 3 2 4-10" stroke-width="2.4" data-ink="3" pathLength="1"/>
      <path d="m135 99 27-7m-21 16 35-10m-28 18 31-9m-23 12 18-5" stroke-width="1" data-ink="2" pathLength="1"/>
      <path d="m163 75 36-10 28 37-40 11z" stroke-dasharray="2 3" opacity=".6"/>
      <path d="m176 89 6-11 19 4zm3 2 24-6m-21 9 5 5m0-6 5 5m1-7 5 6m0-7 5 5m-19 7 24-6m-23 9 25-7" stroke-width="1.8" data-ink="2" pathLength="1"/>
    </g>
    <path d="M256 76c11-13 10-31 0-34-12-3-11 15 1 11 10-3 16-15 25-17m-7 1 8-2-3 7" stroke-width="1.25" data-ink="3" pathLength="1"/>
    <text x="259" y="29" transform="rotate(-6 259 29)" class="drawing-label" data-ink-label>eligible!</text>
    <g stroke-width=".85" opacity=".5"><path d="m56 109 9-2m-4-3 2 8m204 35 9-2m-5-3 2 8m-164 10 6-2m-4-1 1 5" data-ink="3" pathLength="1"/></g>
  </>}
  {drawing === 'media' && <>
    <g transform="rotate(-8 176 97)">
      <path d="M43 132c48 20 64-9 111-20s67-2 85 11c8 5 14 5 18-1l28-43c5-13-17-30-37-34-14-3-25-2-42 0-55 8-67 55-119 52-9 0-17-1-26-5z" class="drawing-page" data-ink="1" pathLength="1"/>
      <path d="M44 132c47 19 68-11 111-20s65-2 85 11c9 5 15 4 18-4 6-17-19-29-39-32-24-3-44 3-70 17-46 24-77 27-98 15" class="drawing-accent" stroke-width="1.3" data-ink="1" pathLength="1"/>
      <path d="M61 92c25 11 55 5 82-17s48-30 71-32c36-4 74 8 72 32-1 8-5 15-13 21" stroke-width="2.1" data-ink="1" pathLength="1"/>
      <path d="M44 132l17-40m4 8c33 10 54-3 81-23s50-29 72-29c27-1 54 5 61 20m-226 52c30 8 53 1 84-18 32-20 51-29 76-30 20-1 44 5 57 16" stroke-width="1" data-ink="2" pathLength="1"/>
